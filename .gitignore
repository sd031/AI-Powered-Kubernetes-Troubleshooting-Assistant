!.env.example

# ─── Runbooks (generated at runtime) ─────────────────────────────────────────
runbooks/

# ─── Node / frontend ──────────────────────────────────────────────────────────
web/frontend/node_modules/
web/frontend/dist/
web/frontend/*.tsbuildinfo

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

