# ─── LLM Provider ────────────────────────────────────────────────────────────
# Choose one: ollama | bedrock | openai
LLM_PROVIDER=ollama

# ─── Ollama (local, no API key needed) ───────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── AWS Bedrock ──────────────────────────────────────────────────────────────
# Auth priority (first match wins):
#   1. BEDROCK_API_KEY  — Bearer token from AWS Console → Bedrock → API keys
#                         (short-term: ≤12 h  |  long-term: user-defined expiry)
#   2. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY  — IAM user credentials (legacy)
#   3. Default AWS credential chain — IAM role, ~/.aws/credentials, EC2 instance profile …
#
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Bedrock API key (Bearer token) — recommended
BEDROCK_API_KEY=

# IAM credentials — fallback if no Bearer token is set
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional STS / SSO session token
AWS_SESSION_TOKEN=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# OPENAI_API_KEY can also be exported as a shell environment variable instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Kubernetes ───────────────────────────────────────────────────────────────
# Path to kubeconfig (leave blank to use ~/.kube/config)
KUBECONFIG=
# Specific context to use (leave blank to use the current context)
K8S_CONTEXT=

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Set to true to apply fixes without confirmation prompts
AUTO_FIX=false
# Directory where runbooks are saved
RUNBOOK_DIR=./runbooks
# Max log lines fetched per pod
MAX_LOG_LINES=200
# Verbose debug output
DEBUG=false
